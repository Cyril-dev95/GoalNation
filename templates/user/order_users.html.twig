{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/user.css') }}">
{% endblock %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
<div class="user-layout">
    {% include 'user/menu.html.twig' %}
    <div class="user-content">
        <h2>Mes commandes</h2>
        {% if orders is empty %}
            <p>Aucune commande passée.</p>
        {% else %}
            <ul class="orders-scroll">
                {% for order in orders %}
                    <li class="order-main">
                        <div class="order-main-row">
                            {% set firstDetail = order.orderDetails|first %}
                            {% if firstDetail %}
                                <img src="{{ asset('images/' ~ firstDetail.product.imageUrl ~ '.webp') }}" alt="{{ firstDetail.product.productName }}" class="order-main-img">
                            {% endif %}
                            <div class="order-main-infos">
                                <strong>Commande du {{ order.createdAt|date('d/m/Y H:i') }}</strong>
                                <ul class="order-details-list">
                                    {% for detail in order.orderDetails %}
                                        <li class="order-detail">
                                            <strong>{{ detail.product.productName }}</strong>
                                        </li>
                                    {% endfor %}
                                </ul>
                                <span class="order-main-total">Total : {{ order.total }} € | Statut : {{ order.status }}</span>
                            </div>
                            <div class="info-quantity">
                                {% for detail in order.orderDetails %}
                                    Quantité : {{ detail.quantity }}<br>
                                {% endfor %}
                            </div>
                        </div>
                    </li>
                    {% if not loop.last %}
                        <hr class="user-separator">
                    {% endif %}
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
{% endblock %}