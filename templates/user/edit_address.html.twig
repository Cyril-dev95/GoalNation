{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/user.css') }}">
{% endblock %}

{% block title %}Modifier mon adresse{% endblock %}

{% block body %}
<div class="user-layout">
    {% include 'user/menu.html.twig' %}
    <div class="user-content" style="display: flex; justify-content: center; align-items: flex-start;">
        <div class="connexion-container-edit-address">
            <h1>Modifier mon adresse</h1>
            <form method="post" action="{{ path('user_edit_address') }}">
                <div class="form-group">
                    <label for="address">Nouvelle adresse :</label>
                    <input type="text" id="address" name="address" value="{{ app.user.address }}" required>
                </div>
                <button type="submit">Enregistrer</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}