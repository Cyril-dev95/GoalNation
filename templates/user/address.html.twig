{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/user.css') }}">
{% endblock %}

{% block title %}Mon adresse{% endblock %}

{% block body %}
<div class="user-layout">
    {% include 'user/menu.html.twig' %}
    <div class="user-content">
        <h2>Mon adresse</h2>
        <div class="adress-container">
            <p>{{ app.user.address }}</p>
            <a href="{{ path('user_edit_address') }}">Modifier mon adresse</a>
        </div>
    </div>
</div>
{% endblock %}