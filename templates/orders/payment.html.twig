<title>{% block title %}Paiement{% endblock %}</title>

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/user.css') }}">
{% endblock %}

{% block body %}

    <div class="payment-container">
        <h2>Veuillez saisir vos informations pour finaliser votre achat :</h2>
        <p>Total à payer : <strong>{{ total|number_format(2, '.', ',') }} €</strong></p>

        <form id="payment-form">
            <div id="card-element"></div>
            <button id="submit" class="pay-btn">Payer</button>
            <div id="card-errors" role="alert"></div>
        </form>

        <script src="https://js.stripe.com/v3/"></script>
        <script>
            // Passe la clé publique Stripe à ton JS global
            window.stripePublicKey = "{{ stripe_public_key }}";
        </script>
        <script src="{{ asset('stripePayment.js') }}"></script>
    </div>

{% endblock %}