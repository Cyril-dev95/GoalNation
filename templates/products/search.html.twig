{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/products.css') }}">
{% endblock %}

{% block body %}
    <main class="products-layout">
        <button id="open-filter-btn" class="filter-toggle-btn">
            <img src="{{ asset('images/icons8-filtre-100.png') }}" alt="Filtrer" />
            <span class="filter-btn-text">Filtres</span>
        </button>
        <aside>
            {% set sizes = sizes|default([]) %}
            {% include 'products/filter_form.html.twig' with {
                'brands': brands|default([]),
                'sizes': sizes|default([]),
                'teams': teams|default([]),
                'clubs': clubs|default([]),
                'price': price|default(0)
            } %}
        </aside>
        <section class="products-content">
            <h1>Produits</h1>
            <section class="products" id="products-list">
                {% for product in products %}
                    <article class="product">
                        {% if product.imageUrl %}
                            <img src="{{ asset('images/' ~ product.imageUrl ~ '.webp') }}" alt="{{ product.productName }}" style="max-width: 250px;">
                        {% else %}
                            <p>Aucune image disponible</p>
                        {% endif %}
                        <div class="product-info-row">
                            <div class="product-info-left">
                                <p><strong>{{ product.brand }}</strong></p>
                                <p>{{ product.productName }}</p>
                            </div>
                            <div class="product-info-price">
                                <p>{{ product.price }} €</p>
                            </div>
                        </div>
                        <div class="product-actions">
                            <a href="{{ path('app_products_show', { id: product.id }) }}" class="btn btn-secondary">Voir Plus</a>
                            <a href="{{ path('app_cart_add', { id: product.id }) }}" class="btn btn-primary">Ajouter au panier</a>
                        </div>
                    </article>
                {% else %}
                    <p>Aucun produit trouvé pour les critères sélectionnés.</p>
                {% endfor %}
            </section>
            {{ knp_pagination_render(products, 'bundles/KnpPaginatorBundle/custom_pagination.html.twig') }}
        </section>
    </main>
{% endblock %}