{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/user.css') }}">
{% endblock %}

{% block body %}
    <main class="register-center">
        {# Affichage des messages flash au-dessus du formulaire #}
        {% set successMessages = app.flashes('success') %}
        {% for message in successMessages %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <section class="register-container">
            <h1>Créer un compte</h1>
            {{ form_start(registrationForm) }}
                {{ form_widget(registrationForm) }}
                <button type="submit" class="register-btn">Enregistrez-vous</button>
            {{ form_end(registrationForm) }}
        </section>
    </main>
{% endblock %}