{% extends 'base.html.twig' %} {# Étend le template de base 'base.html.twig' #}

{% block title %}Hello RegistrationController!{% endblock %} {# Définit le titre de la page #}

{% block body %} {# Début du bloc 'body' #}
    <h1>Register</h1> {# Titre de la page #}
    {{ form_start(registrationForm) }} {# Début du formulaire d'inscription #}
        {{ form_widget(registrationForm) }} {# Affiche tous les champs du formulaire d'inscription #}
        <button type="submit" class="btn">Register</button> {# Bouton de soumission du formulaire #}
    {{ form_end(registrationForm) }} {# Fin du formulaire d'inscription #}
{% endblock %} {# Fin du bloc 'body' #}
