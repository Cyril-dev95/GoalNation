{% extends 'base.html.twig' %}

{% block title %}Actus Football Français{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/news.css') }}">
{% endblock %}

{% block body %}
    <section>
        <h1>Les Actus du Football Français</h1>
        <div class="news-container">
            <ul>
                {% for article in articles %}
                    <li{% if loop.first %} class="first-article"{% endif %}>
                        <article>
                            <a href="{{ article.url }}" target="_blank"><h2>{{ article.title }}</h2></a><br>
                            <div class="article-container">
                                {% if article.urlToImage %}
                                    <img src="{{ article.urlToImage }}" alt="Illustration de l'article : {{ article.title }}">
                                {% endif %}
                                <div class="article-desc">
                                    {{ article.description }}
                                    <br>
                                    <small>{{ article.publishedAt|date('d/m/Y H:i') }}</small>
                                    <a href="{{ article.url }}" target="_blank"><strong>Voir Plus >></strong></a>
                                </div>
                            </div>
                        </article>
                    </li>
                    <hr class="article-separator">
                {% else %}
                    <li>Aucune news trouvée.</li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endblock %}