{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/user.css') }}">
{% endblock %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<div class="cart-container">
    <h1>Mon Panier</h1>

    <table>
        <thead>
            <tr>
                <th></th>
                <th>Produit</th>
                <th>Quantité</th>
                <th>Prix</th>
            </tr>
        </thead>
        <tbody>
            {% if cart is empty %} {# Si le panier est vide #}
                <tr>
                    <td colspan="5">Votre panier est vide.</td>
                </tr>
            {% else %} {# Sinon, afficher les produits du panier #}
                {% for item in cart %} {# Boucle sur chaque élément du panier #}
                    <tr>
                        <td><img src="{{ asset('images/' ~ item.product.imageUrl ~ '.webp') }}" alt="{{ item.product.productName }}" style="max-width: 100px;"></td>
                        <td>{{ item.product.productName }}</td> {# Affiche le nom du produit #}
                        <td class="item-quantity">{{ item.quantity }}</td> {# Affiche la quantité du produit #}
                        <td class="item-price">{{ item.product.price|number_format(2, '.', ',') }} €</td> {# Affiche le prix unitaire formaté du produit #}
                            <td class="item-btns">
                            <form action="{{ path('app_cart_increase', { id: item.product.id }) }}" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-success">+</button>
                            </form>
                            <form action="{{ path('app_cart_decrease', { id: item.product.id }) }}" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-warning">-</button>
                            </form>
                            <form action="{{ path('app_cart_remove', { id: item.product.id }) }}" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger">Retirer</button>
                            </form>
                        </td>
                        
                        
                    </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    </table>

    <h2>Total: {{ total|number_format(2, '.', ',') }} €</h2> {# Affiche le total formaté du panier #}

    {% if not cart is empty %} {# Si le panier n'est pas vide #}
        <form action="{{ path('order_payment') }}" method="post"> {# Formulaire pour passer la commande #}
            <button type="submit" class="btn btn-primary">Passer la commande</button>
        </form>
    {% endif %}
</div>
    
{% endblock %}