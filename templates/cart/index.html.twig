{% extends 'base.html.twig' %} {# Étend le template de base 'base.html.twig' #}

{% block title %}Mon Panier{% endblock %} {# Définit le titre de la page #}

{% block body %} {# Début du bloc 'body' #}
    <h1>Mon Panier</h1> {# Titre de la page #}

    <table> {# Début du tableau #}
        <thead> {# En-tête du tableau #}
            <tr>
                <th></th>
                <th>Produit</th> {# Colonne pour le nom du produit #}
                <th>Quantité</th> {# Colonne pour la quantité du produit #}
                <th>Prix</th> {# Colonne pour le prix unitaire du produit #}
                <th>Total</th> {# Colonne pour le prix total du produit #}
                <th>Actions</th> {# Colonne pour les actions (augmenter, diminuer, retirer) #}
            </tr>
        </thead>
        <tbody>
            {% if cart is empty %} {# Si le panier est vide #}
                <tr>
                    <td colspan="5">Votre panier est vide.</td>
                </tr>
            {% else %} {# Sinon, afficher les produits du panier #}
                {% for item in cart %} {# Boucle sur chaque élément du panier #}
                    <tr>
                        <td><img src="{{ asset('images/' ~ item.product.imageUrl ~ '.webp') }}" alt="{{ item.product.productName }}" style="max-width: 100px;"></td>
                        <td>{{ item.product.productName }}</td> {# Affiche le nom du produit #}
                        <td>{{ item.quantity }}</td> {# Affiche la quantité du produit #}
                        <td>{{ item.product.price|number_format(2, '.', ',') }} €</td> {# Affiche le prix unitaire formaté du produit #}
                        <td>{{ (item.product.price * item.quantity)|number_format(2, '.', ',') }} €</td> {# Affiche le prix total formaté du produit #}
                        <td>
                            <form action="{{ path('app_cart_increase', { id: item.product.id }) }}" method="post" style="display:inline;"> {# Formulaire pour augmenter la quantité du produit #}
                                <button type="submit" class="btn btn-success">+</button> {# Bouton pour augmenter la quantité #}
                            </form>
                            <form action="{{ path('app_cart_decrease', { id: item.product.id }) }}" method="post" style="display:inline;"> {# Formulaire pour diminuer la quantité du produit #}
                                <button type="submit" class="btn btn-warning">-</button> {# Bouton pour diminuer la quantité #}
                            </form>
                            <form action="{{ path('app_cart_remove', { id: item.product.id }) }}" method="post" style="display:inline;"> {# Formulaire pour retirer le produit du panier #}
                                <button type="submit" class="btn btn-danger">Retirer</button> {# Bouton pour retirer le produit #}
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    </table>

    <h2>Total: {{ total|number_format(2, '.', ',') }} €</h2> {# Affiche le total formaté du panier #}

    {% if not cart is empty %} {# Si le panier n'est pas vide #}
        <form action="{{ path('order_payment') }}" method="post"> {# Formulaire pour passer la commande #}
            <button type="submit" class="btn btn-primary">Passer la commande</button>
        </form>
    {% endif %}
{% endblock %}